VITE_APP_TITLE=四川飞豹救援后台管理系统
VITE_APP_BASE_API=/api
VITE_APP_PORT=5176
VITE_API_BASE_URL=http://localhost:3003
# 手机扫码最简单：固定手机可访问的官网根地址（改配置后需重启 npm run dev）。
# 本地真机联调使用电脑局域网 IP；正式/测试部署再改为实际官网域名。
VITE_PORTAL_PUBLIC_URL=http://192.168.2.189:5173
# VITE_PORTAL_DEV_PORT=5173
#
# 测试构建：npm run dev:test / npm run build:test（加载 .env.test）
# 生产构建：在 .env.production 配 VITE_PORTAL_PUBLIC_URL 后 npm run build
