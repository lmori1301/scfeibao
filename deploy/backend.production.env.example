# Backend production environment example for Sichuan Feibao official website.
# Copy to backend/.env on the production server and fill secrets before start.

NODE_ENV=production
HOST=0.0.0.0
PORT=3003
API_PREFIX=api

# Public website origin used by QR code and public links.
PORTAL_PUBLIC_URL=https://www.scfb.org.cn

# Personnel QR mobile detail page. Keep this as the public website origin;
# Nginx must proxy /api/ to the backend so the final QR URL becomes:
# https://www.scfb.org.cn/api/personnel/{id}/mobile
PERSONNEL_QRCODE_PUBLIC_URL=https://www.scfb.org.cn

# CORS origins for admin and website. Adjust if admin uses a separate domain.
CORS_ORIGIN=https://www.scfb.org.cn

# Database and secrets must be filled on server.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=scfeibao
DB_PASSWORD=your_production_password
DB_DATABASE=scfeibao
JWT_SECRET=

# AMap Web Service key for backend address geocoding.
AMAP_WEB_KEY=
AMAP_SECURITY_JSCODE=
