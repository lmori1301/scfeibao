# 应用配置
NODE_ENV=development
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=feibao_rescue

# JWT配置
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# CORS配置（本地开发）；生产部署请改为门户/后台实际来源，例如 https://scfb.org.cn
CORS_ORIGIN=http://localhost:5173

# 人员二维码内嵌的官网根地址（手机可访问，勿带路径）。不配时管理端可在请求中传 portalBase 查询参数。
# 生产示例（域名 scfb.org.cn）：
# PORTAL_PUBLIC_URL=https://scfb.org.cn
# 兼容旧变量名
# FRONTEND_URL=http://localhost:5173

# API前缀
API_PREFIX=api
