# 复制为 .env 后填写。不要将 .env 提交到 Git。
# 本配置用于生产服务器部署（宝塔 + Docker + GitHub Actions 自动构建）。

# GitHub 镜像归属（小写用户名），保持默认即可
IMAGE_OWNER=lmori1301
IMAGE_TAG=latest

# 对外端口（只绑定 127.0.0.1，外部流量走宝塔 Nginx）
WEBSITE_PORT=8081
ADMIN_PORT=8080

# MySQL
DB_DATABASE=scfeibao
DB_USERNAME=scfeibao
DB_PASSWORD=replace_with_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password

# 后端安全配置，生产环境请使用至少 32 字节随机值
# 生成方式：openssl rand -hex 32
JWT_SECRET=replace_with_long_random_jwt_secret
ALLOW_PUBLIC_REGISTRATION=false

# 公网域名
# 人员二维码内嵌的官网根地址；手机扫码必须填「手机可访问」的 https 地址
CORS_ORIGIN=https://www.scfb.org.cn,https://admin.scfb.org.cn
PORTAL_PUBLIC_URL=https://www.scfb.org.cn
PERSONNEL_QRCODE_PUBLIC_URL=https://www.scfb.org.cn

# 高德地图：Web 服务 Key 仅供后端；JSAPI Key/JSCODE 会编译进前端
AMAP_WEB_KEY=
AMAP_SECURITY_JSCODE=
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_JSCODE=

# 官网门户公开地址，编译进 admin 前端；与 PORTAL_PUBLIC_URL 保持一致
VITE_PORTAL_PUBLIC_URL=https://www.scfb.org.cn
