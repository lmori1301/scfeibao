# 复制为 .env 后填写。不要将 .env 提交到 Git。

# 对外端口
WEBSITE_PORT=80
ADMIN_PORT=8080

# MySQL
DB_DATABASE=scfeibao
DB_USERNAME=scfeibao
DB_PASSWORD=replace_with_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password

# 后端安全配置，生产环境请使用至少 32 字节随机值
JWT_SECRET=replace_with_long_random_jwt_secret
ALLOW_PUBLIC_REGISTRATION=false

# 公网地址
CORS_ORIGIN=https://www.scfb.org.cn
PORTAL_PUBLIC_URL=https://www.scfb.org.cn
PERSONNEL_QRCODE_PUBLIC_URL=https://www.scfb.org.cn

# 高德地图：Web 服务 Key 仅供后端；JSAPI Key/JSCODE 会编译进前端
AMAP_WEB_KEY=
AMAP_SECURITY_JSCODE=
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_JSCODE=
