{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "id": "session-start:bootstrap",
            "description": "会话启动时清理状态并注入强制执行清单",
            "type": "command",
            "command": "node -e \"let d='';process.stdin.setEncoding('utf8');process.stdin.on('data',function(c){d+=c});process.stdin.on('end',function(){const p=require('path'),fs=require('fs');let r=process.cwd();while(!fs.existsSync(p.join(r,'.claude','hooks','run.cjs'))){const n=p.dirname(r);if(n===r)process.exit(0);r=n;}const h=require(p.join(r,'.claude','hooks',process.argv[1]+'.cjs'));let i={};try{i=JSON.parse(d)}catch{}const o=h.run(i);if(o)process.stdout.write(JSON.stringify(o))})\" session-start",
            "timeout": 10000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "id": "prompt:round-reset",
            "description": "用户发新消息时重置本轮编辑/review 累积状态",
            "type": "command",
            "command": "node -e \"let d='';process.stdin.setEncoding('utf8');process.stdin.on('data',function(c){d+=c});process.stdin.on('end',function(){const p=require('path'),fs=require('fs');let r=process.cwd();while(!fs.existsSync(p.join(r,'.claude','hooks','run.cjs'))){const n=p.dirname(r);if(n===r)process.exit(0);r=n;}const h=require(p.join(r,'.claude','hooks',process.argv[1]+'.cjs'));let i={};try{i=JSON.parse(d)}catch{}const o=h.run(i);if(o)process.stdout.write(JSON.stringify(o))})\" round-reset",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "id": "pre:edit:config-protection",
            "description": "阻止修改 linter/formatter/tsconfig 配置文件（不靠放宽规则来消错）",
            "type": "command",
            "command": "node -e \"let d='';process.stdin.setEncoding('utf8');process.stdin.on('data',function(c){d+=c});process.stdin.on('end',function(){const p=require('path'),fs=require('fs');let r=process.cwd();while(!fs.existsSync(p.join(r,'.claude','hooks','run.cjs'))){const n=p.dirname(r);if(n===r)process.exit(0);r=n;}const {runAll}=require(p.join(r,'.claude','hooks','run.cjs'));let i={};try{i=JSON.parse(d)}catch{}const o=runAll(process.argv.slice(1),i);if(o)process.stdout.write(JSON.stringify(o))})\" config-protection",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "id": "pre:bash:bash-guard",
            "description": "拦截 find / 等越界全盘扫描命令（提示词约束不住，需机械拦截）",
            "type": "command",
            "command": "node -e \"let d='';process.stdin.setEncoding('utf8');process.stdin.on('data',function(c){d+=c});process.stdin.on('end',function(){const p=require('path'),fs=require('fs');let r=process.cwd();while(!fs.existsSync(p.join(r,'.claude','hooks','run.cjs'))){const n=p.dirname(r);if(n===r)process.exit(0);r=n;}const h=require(p.join(r,'.claude','hooks',process.argv[1]+'.cjs'));let i={};try{i=JSON.parse(d)}catch{}const o=h.run(i);if(o)process.stdout.write(JSON.stringify(o))})\" bash-guard",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "id": "post:edit:review-reminder",
            "description": "代码修改后注入 code-reviewer 强制提醒",
            "type": "command",
            "command": "node -e \"let d='';process.stdin.setEncoding('utf8');process.stdin.on('data',function(c){d+=c});process.stdin.on('end',function(){const p=require('path'),fs=require('fs');let r=process.cwd();while(!fs.existsSync(p.join(r,'.claude','hooks','run.cjs'))){const n=p.dirname(r);if(n===r)process.exit(0);r=n;}const h=require(p.join(r,'.claude','hooks',process.argv[1]+'.cjs'));let i={};try{i=JSON.parse(d)}catch{}const o=h.run(i);if(o)process.stdout.write(JSON.stringify(o))})\" review-reminder",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "id": "post:agent:review-tracker",
            "description": "追踪 code-reviewer 调用",
            "type": "command",
            "command": "node -e \"let d='';process.stdin.setEncoding('utf8');process.stdin.on('data',function(c){d+=c});process.stdin.on('end',function(){const p=require('path'),fs=require('fs');let r=process.cwd();while(!fs.existsSync(p.join(r,'.claude','hooks','run.cjs'))){const n=p.dirname(r);if(n===r)process.exit(0);r=n;}const h=require(p.join(r,'.claude','hooks',process.argv[1]+'.cjs'));let i={};try{i=JSON.parse(d)}catch{}const o=h.run(i);if(o)process.stdout.write(JSON.stringify(o))})\" review-tracker",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "id": "pre-compact:save-state",
            "description": "上下文压缩前保存工作状态快照",
            "type": "command",
            "command": "node -e \"let d='';process.stdin.setEncoding('utf8');process.stdin.on('data',function(c){d+=c});process.stdin.on('end',function(){const p=require('path'),fs=require('fs');let r=process.cwd();while(!fs.existsSync(p.join(r,'.claude','hooks','run.cjs'))){const n=p.dirname(r);if(n===r)process.exit(0);r=n;}const h=require(p.join(r,'.claude','hooks',process.argv[1]+'.cjs'));let i={};try{i=JSON.parse(d)}catch{}const o=h.run(i);if(o)process.stdout.write(JSON.stringify(o))})\" pre-compact",
            "timeout": 10000
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "id": "stop:quality-gate",
            "description": "回复结束时检查 console.log 残留和 review 调用",
            "type": "command",
            "command": "node -e \"let d='';process.stdin.setEncoding('utf8');process.stdin.on('data',function(c){d+=c});process.stdin.on('end',function(){const p=require('path'),fs=require('fs');let r=process.cwd();while(!fs.existsSync(p.join(r,'.claude','hooks','run.cjs'))){const n=p.dirname(r);if(n===r)process.exit(0);r=n;}const h=require(p.join(r,'.claude','hooks',process.argv[1]+'.cjs'));let i={};try{i=JSON.parse(d)}catch{}const o=h.run(i);if(o)process.stdout.write(JSON.stringify(o))})\" stop-quality-gate",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
